{
  "experiment_id": "ehrshot-celiac-ofat-v1",
  "description": "One-factor-at-a-time agentic benchmark with full-pipeline replication.",
  "evaluation_policy": {
    "primary_metrics": ["auroc", "f1", "recall", "precision", "brier"],
    "secondary_metrics": ["accuracy"],
    "note": "Accuracy is secondary because the diagnosis outcome is imbalanced."
  },
  "task": {
    "dataset": "EHRSHOT",
    "data_root": "/app/data/EHR_SHOT",
    "outcome": "new_celiac",
    "patient_id_column": "patient_id",
    "seed": 42,
    "test_fraction": 0.2,
    "validation_fraction": 0.2,
    "split_file": "/app/experiments/splits/ehrshot_celiac_seed42.json"
  },
  "baseline": {
    "number_of_models": 5,
    "max_search_results": 1,
    "model": "gpt-5.4-mini",
    "temperature": 0.0,
    "prompt_variant": "baseline"
  },
  "conditions": [
    {
      "condition_id": "baseline",
      "repetitions": 10,
      "overrides": {}
    },
    {
      "condition_id": "temperature_0_3",
      "repetitions": 10,
      "overrides": {"temperature": 0.3}
    },
    {
      "condition_id": "temperature_1_0",
      "repetitions": 10,
      "overrides": {"temperature": 1.0}
    }
  ]
}
